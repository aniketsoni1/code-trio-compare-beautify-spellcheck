{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@ctr/core": ["packages/core/src/index.ts"],
      "@ctr/core/*": ["packages/core/src/*"],
      "@ctr/diff-engine": ["packages/diff-engine/src/index.ts"],
      "@ctr/diff-engine/*": ["packages/diff-engine/src/*"],
      "@ctr/spell-engine": ["packages/spell-engine/src/index.ts"],
      "@ctr/spell-engine/*": ["packages/spell-engine/src/*"],
      "@ctr/format-engine": ["packages/format-engine/src/index.ts"],
      "@ctr/format-engine/*": ["packages/format-engine/src/*"],
      "@ctr/reporting": ["packages/reporting/src/index.ts"],
      "@ctr/reporting/*": ["packages/reporting/src/*"],
      "@ctr/configuration": ["packages/configuration/src/index.ts"],
      "@ctr/configuration/*": ["packages/configuration/src/*"],
      "@ctr/agent": ["packages/agent/src/index.ts"],
      "@ctr/agent/*": ["packages/agent/src/*"],
      "@ctr/dictionaries": ["packages/dictionaries/src/index.ts"],
      "@ctr/dictionaries/*": ["packages/dictionaries/src/*"],
      "@ctr/formatters": ["packages/formatters/src/index.ts"],
      "@ctr/formatters/*": ["packages/formatters/src/*"],
      "@ctr/testing": ["packages/testing/src/index.ts"],
      "@ctr/testing/*": ["packages/testing/src/*"]
    }
  }
}
