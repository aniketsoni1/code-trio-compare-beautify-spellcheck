{
  "name": "code-trio-compare-beautify-spellcheck",
  "displayName": "Code Trio - Compare Beautify Spellcheck",
  "version": "0.1.0",
  "publisher": "AniketSoni",
  "description": "Three offline dev tools in one: code compare/diff, code-aware spell check, and beautify/format. Deterministic, private, no telemetry.",
  "license": "Apache-2.0",
  "author": "aniketsoni1",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "homepage": "https://github.com/aniketsoni1/code-trio-compare-beautify-spellcheck#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniketsoni1/code-trio-compare-beautify-spellcheck.git",
    "directory": "apps/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/aniketsoni1/code-trio-compare-beautify-spellcheck/issues"
  },
  "qna": "https://github.com/aniketsoni1/code-trio-compare-beautify-spellcheck/discussions",
  "sponsor": {
    "url": "https://github.com/sponsors/aniketsoni1"
  },
  "categories": [
    "Formatters",
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "diff",
    "compare",
    "merge",
    "spell check",
    "spellcheck",
    "formatter",
    "beautify",
    "prettier",
    "offline",
    "privacy"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "type": "commonjs",
  "main": "./out/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Code Trio runs read-only: compare and spell diagnostics work, but applying formatting and writing to the project dictionary are disabled."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Compare and spell check work in virtual workspaces; git-ref compare and format-on-save may be unavailable."
    }
  },
  "activationEvents": [
    "onView:codeTrio.resultsView",
    "onView:codeTrio.summaryView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeTrio.compareWith",
        "title": "Compare Active File With File...",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.compareWithClipboard",
        "title": "Compare Active File With Clipboard",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.compareWithGitRef",
        "title": "Compare Active File With Git Ref...",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.compareSelected",
        "title": "Compare Two Selected Files",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.compareSelectionWithClipboard",
        "title": "Compare Selection With Clipboard",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.compareWithSaved",
        "title": "Compare With Saved Version On Disk",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.compareWithPreviousRevision",
        "title": "Compare With Previous Revision (HEAD~1)",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.mergeFromGit",
        "title": "Merge Conflicted File (Git)",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.mergeFiles",
        "title": "Merge Three Files...",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.mergeNextConflict",
        "title": "Next Merge Conflict",
        "category": "Code Trio",
        "icon": "$(arrow-down)"
      },
      {
        "command": "codeTrio.mergePreviousConflict",
        "title": "Previous Merge Conflict",
        "category": "Code Trio",
        "icon": "$(arrow-up)"
      },
      {
        "command": "codeTrio.mergePreview",
        "title": "Preview Merged Result",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.mergeSave",
        "title": "Save Merged Result As...",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.spellCheckFile",
        "title": "Spell Check Current File",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.spellCheckWorkspace",
        "title": "Spell Check Workspace",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.spellFixAllInFile",
        "title": "Fix All Spelling In File",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.spellAddWord",
        "title": "Add Word To Project Dictionary",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.spellIgnoreSession",
        "title": "Ignore Word For This Session",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.spellClearSessionIgnores",
        "title": "Clear Session Ignore List",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.openWorkspaceDictionary",
        "title": "Open Workspace Dictionary",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.openFolderDictionary",
        "title": "Open Workspace Folder Dictionary",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.openUserDictionary",
        "title": "Open User Dictionary",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.showDictionarySources",
        "title": "Show Dictionary Sources",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.formatDocument",
        "title": "Beautify Document",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.formatPreview",
        "title": "Preview Beautify Changes (Dry Run)",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.formatChangedFiles",
        "title": "Beautify Changed Files Only",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.formatWorkspace",
        "title": "Beautify Entire Workspace...",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.showFormatters",
        "title": "Show Available Formatters",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.showPanel",
        "title": "Show Results Panel",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.exportResults",
        "title": "Export Results...",
        "category": "Code Trio"
      },
      {
        "command": "codeTrio.refreshResults",
        "title": "Refresh Results",
        "category": "Code Trio",
        "icon": "$(refresh)"
      },
      {
        "command": "codeTrio.clearResults",
        "title": "Clear Results",
        "category": "Code Trio",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeTrio",
          "title": "Code Trio",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "codeTrio": [
        {
          "id": "codeTrio.resultsView",
          "name": "Results",
          "type": "webview",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Code Trio"
        },
        {
          "id": "codeTrio.summaryView",
          "name": "Summary",
          "icon": "media/activity-bar.svg",
          "contextualTitle": "Code Trio"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeTrio.summaryView",
        "contents": "Code Trio bundles three offline tools: compare, spell check, and beautify.\n[Compare Active File](command:codeTrio.compareWith)\n[Spell Check File](command:codeTrio.spellCheckFile)\n[Beautify Document](command:codeTrio.formatDocument)\nAll processing happens locally with no network calls."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codeTrio.spellAddWord",
          "when": "false"
        },
        {
          "command": "codeTrio.spellIgnoreSession",
          "when": "false"
        },
        {
          "command": "codeTrio.refreshResults",
          "when": "false"
        },
        {
          "command": "codeTrio.clearResults",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "codeTrio.editorContext",
          "group": "1_modification@99"
        }
      ],
      "codeTrio.editorContext": [
        {
          "command": "codeTrio.compareWith",
          "group": "1_compare@1"
        },
        {
          "command": "codeTrio.compareWithClipboard",
          "group": "1_compare@2"
        },
        {
          "command": "codeTrio.compareWithSaved",
          "group": "1_compare@3"
        },
        {
          "command": "codeTrio.compareWithGitRef",
          "group": "1_compare@4"
        },
        {
          "command": "codeTrio.spellCheckFile",
          "group": "2_spell@1"
        },
        {
          "command": "codeTrio.formatPreview",
          "group": "3_format@1"
        },
        {
          "command": "codeTrio.formatDocument",
          "group": "3_format@2"
        }
      ],
      "view/title": [
        {
          "command": "codeTrio.refreshResults",
          "when": "view == codeTrio.summaryView",
          "group": "navigation@1"
        },
        {
          "command": "codeTrio.clearResults",
          "when": "view == codeTrio.summaryView",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "codeTrio.compareSelected",
          "when": "listMultiSelection && resourceScheme == file",
          "group": "3_compare@1"
        }
      ]
    },
    "submenus": [
      {
        "id": "codeTrio.editorContext",
        "label": "Code Trio"
      }
    ],
    "keybindings": [
      {
        "command": "codeTrio.formatPreview",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "codeTrio.spellCheckFile",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "codeTrio.mergeNextConflict",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "editorTextFocus"
      },
      {
        "command": "codeTrio.mergePreviousConflict",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Code Trio",
      "properties": {
        "codeTrio.diff.granularity": {
          "type": "string",
          "enum": [
            "line",
            "word",
            "char"
          ],
          "default": "word",
          "description": "Default refinement granularity for the compare view.",
          "scope": "resource"
        },
        "codeTrio.diff.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Ignore whitespace-only differences when comparing.",
          "scope": "resource"
        },
        "codeTrio.diff.ignoreCase": {
          "type": "boolean",
          "default": false,
          "description": "Ignore case differences when comparing.",
          "scope": "resource"
        },
        "codeTrio.diff.contextLines": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 3,
          "description": "Unchanged context lines kept around each change in a diff hunk.",
          "scope": "resource"
        },
        "codeTrio.diff.ignoreEol": {
          "type": "boolean",
          "default": false,
          "description": "Treat CRLF, LF and CR as equivalent when comparing. Off by default because a line-ending change is a real change; turn it on for mixed-platform teams where checkout normalisation would otherwise mark every line as modified.",
          "scope": "resource"
        },
        "codeTrio.diff.maxLines": {
          "type": "number",
          "minimum": 1000,
          "maximum": 5000000,
          "default": 300000,
          "description": "Refuse to compare inputs larger than this many lines.",
          "scope": "resource"
        },
        "codeTrio.diff.maxBytes": {
          "type": "number",
          "minimum": 65536,
          "maximum": 536870912,
          "default": 20971520,
          "description": "Refuse to compare inputs larger than this many bytes.",
          "scope": "resource"
        },
        "codeTrio.spell.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable code-aware spell diagnostics.",
          "scope": "resource"
        },
        "codeTrio.spell.checkComments": {
          "type": "boolean",
          "default": true,
          "description": "Spell-check the contents of comments.",
          "scope": "resource"
        },
        "codeTrio.spell.checkStrings": {
          "type": "boolean",
          "default": true,
          "description": "Spell-check the contents of string literals.",
          "scope": "resource"
        },
        "codeTrio.spell.checkIdentifiers": {
          "type": "boolean",
          "default": false,
          "description": "Also spell-check identifiers (opt-in). Identifiers are split on camelCase, snake_case, kebab-case and SCREAMING_CASE before lookup.",
          "scope": "resource"
        },
        "codeTrio.spell.ignoreWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Words to accept without adding them to a dictionary file.",
          "scope": "resource"
        },
        "codeTrio.spell.minWordLength": {
          "type": "number",
          "minimum": 1,
          "maximum": 20,
          "default": 3,
          "description": "Words shorter than this are never reported.",
          "scope": "resource"
        },
        "codeTrio.spell.maxSuggestions": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "default": 5,
          "description": "Maximum number of replacement suggestions offered per unknown word.",
          "scope": "resource"
        },
        "codeTrio.spell.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "information",
          "description": "Severity used for spelling diagnostics.",
          "scope": "resource"
        },
        "codeTrio.spell.dictionaries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "base",
              "technical"
            ]
          },
          "default": [
            "base",
            "technical"
          ],
          "description": "Built-in dictionaries to load.",
          "scope": "resource"
        },
        "codeTrio.spell.projectDictionaryPath": {
          "type": "string",
          "default": ".codetrio/dictionary.txt",
          "description": "Workspace-relative path to the shared project dictionary.",
          "scope": "resource"
        },
        "codeTrio.spell.folderDictionaryPath": {
          "type": "string",
          "default": ".codetrio/dictionary.txt",
          "description": "Dictionary path relative to each workspace folder. Only consulted when the folder differs from the workspace root, which is what makes it useful in a multi-root workspace or monorepo.",
          "scope": "resource"
        },
        "codeTrio.spell.userDictionaryPath": {
          "type": "string",
          "default": ".codetrio/user-dictionary.txt",
          "description": "Personal dictionary, resolved against your home directory. Leave empty to disable the user scope.",
          "scope": "resource"
        },
        "codeTrio.spell.ignoreGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/out/**"
          ],
          "description": "Globs excluded from spell checking.",
          "scope": "resource"
        },
        "codeTrio.spell.ignoreNoiseTokens": {
          "type": "boolean",
          "default": true,
          "description": "Suppress URLs, file paths, hashes, UUIDs, hex values, versions and timestamps before checking. Turning this off substantially increases false positives.",
          "scope": "resource"
        },
        "codeTrio.spell.ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional regular expressions whose matches are never reported.",
          "scope": "resource"
        },
        "codeTrio.spell.checkAcronyms": {
          "type": "boolean",
          "default": false,
          "description": "Also check ALL-CAPS acronym fragments when identifier checking is enabled.",
          "scope": "resource"
        },
        "codeTrio.spell.maxFileSizeKb": {
          "type": "number",
          "minimum": 1,
          "maximum": 102400,
          "default": 2048,
          "description": "Skip documents larger than this instead of scanning them.",
          "scope": "resource"
        },
        "codeTrio.spell.maxDiagnostics": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000,
          "default": 1000,
          "description": "Maximum spelling diagnostics reported for a single document.",
          "scope": "resource"
        },
        "codeTrio.format.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Beautify supported files on save (opt-in).",
          "scope": "resource"
        },
        "codeTrio.format.previewBeforeApply": {
          "type": "boolean",
          "default": true,
          "description": "Show a dry-run diff preview before applying formatting from the command.",
          "scope": "resource"
        },
        "codeTrio.format.pinnedVersions": {
          "type": "boolean",
          "default": true,
          "description": "Record the formatter name and version in results for reproducibility.",
          "scope": "resource"
        },
        "codeTrio.format.tabWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 16,
          "default": 2,
          "description": "Indentation width passed to formatters that accept one.",
          "scope": "resource"
        },
        "codeTrio.format.useTabs": {
          "type": "boolean",
          "default": false,
          "description": "Indent with tabs instead of spaces where the formatter supports it.",
          "scope": "resource"
        },
        "codeTrio.format.printWidth": {
          "type": "number",
          "minimum": 20,
          "maximum": 400,
          "default": 80,
          "description": "Preferred maximum line width passed to formatters that accept one.",
          "scope": "resource"
        },
        "codeTrio.externalFormatters.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow Code Trio to discover and run locally installed formatters (Ruff, Black, gofmt, rustfmt, clang-format). Code Trio never downloads a formatter. When disabled, only the bundled Prettier and the whitespace normalizer are used and no external process is started.",
          "scope": "resource"
        },
        "codeTrio.externalFormatters.paths": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Absolute paths to specific formatter executables, keyed by adapter id (`ruff`, `black`, `gofmt`, `rustfmt`, `clang-format`). Overrides PATH lookup. Relative paths are rejected.",
          "scope": "resource"
        },
        "codeTrio.externalFormatters.timeoutMs": {
          "type": "number",
          "minimum": 500,
          "maximum": 120000,
          "default": 10000,
          "description": "Maximum time a single external formatter run may take before it is terminated.",
          "scope": "resource"
        },
        "codeTrio.externalFormatters.preferred": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Adapter ids to try first, in order. For example `[\"black\"]` prefers Black over Ruff for Python without disabling either.",
          "scope": "resource"
        }
      }
    },
    "configurationDefaults": {
      "[markdown]": {
        "codeTrio.spell.checkIdentifiers": false
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node ./scripts/build.mjs --production"
  }
}
